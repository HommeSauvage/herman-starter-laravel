{
    "$schema": "./node_modules/oxfmt/configuration_schema.json",
    "printWidth": 80,
    "tabWidth": 4,
    "semi": true,
    "singleQuote": true,
    "singleAttributePerLine": false,
    "htmlWhitespaceSensitivity": "css",
    // Oxfmt's replacement for prettier-plugin-tailwindcss.
    "sortTailwindcss": {
        "stylesheet": "resources/css/app.css",
        "functions": ["clsx", "cn", "cva"]
    },
    // Oxfmt's replacement for eslint-plugin-import's import/order rule.
    "sortImports": true,
    // Prettier never sorted package.json; do not start now.
    "sortPackageJson": false,
    // The old .prettierrc override, which Oxfmt cannot migrate automatically.
    "overrides": [
        {
            "files": ["**/*.yml", "**/*.yaml"],
            "options": {
                "tabWidth": 2
            }
        }
    ],
    // Formerly .prettierignore.
    "ignorePatterns": ["resources/js/components/ui/*", "resources/views/mail/*"]
}
