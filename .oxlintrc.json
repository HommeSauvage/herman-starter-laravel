{
    "$schema": "./node_modules/oxlint/configuration_schema.json",
    // Native Rust ports of the plugins this template used to install from npm:
    // typescript-eslint, eslint-plugin-react (react-hooks included) and
    // eslint-plugin-import. Listing plugins replaces Oxlint's defaults, so
    // every plugin we want stays in the list.
    "plugins": ["typescript", "react", "import", "unicorn", "oxc"],
    // The correctness category is the ground js.configs.recommended and the plugin
    // recommended sets used to cover. Everything below it is the extra
    // style/restriction set the old config opted into explicitly.
    "categories": {
        "correctness": "error"
    },
    "env": {
        "browser": true,
        "builtin": true
    },
    "rules": {
        "curly": ["error", "all"],
        "import/consistent-type-specifier-style": ["error", "prefer-top-level"],
        "no-array-constructor": "error",
        "no-case-declarations": "error",
        "no-empty": "error",
        "no-fallthrough": "error",
        "no-prototype-builtins": "error",
        "no-regex-spaces": "error",
        "react/exhaustive-deps": "warn",
        "react/rules-of-hooks": "error",
        "react/unsupported-syntax": "warn",
        "typescript/ban-ts-comment": "error",
        "typescript/consistent-type-imports": [
            "error",
            {
                "prefer": "type-imports",
                "fixStyle": "separate-type-imports"
            }
        ],
        "typescript/no-empty-object-type": "error",
        "typescript/no-namespace": "error",
        "typescript/no-require-imports": "error",
        "typescript/no-unnecessary-type-constraint": "error",
        "typescript/no-unsafe-function-type": "error"
    },
    // The rules the old config only turned on for TypeScript files, kept off
    // for plain JS where the parser cannot see types.
    "overrides": [
        {
            "files": ["**/*.ts", "**/*.tsx", "**/*.mts", "**/*.cts"],
            "rules": {
                "no-var": "error",
                "prefer-const": "error",
                "prefer-rest-params": "error",
                "prefer-spread": "error"
            }
        }
    ],
    // Generated Wayfinder output, build artifacts and the vendored shadcn
    // primitives are not ours to lint — same set the ESLint config ignored.
    "ignorePatterns": [
        "vendor",
        "node_modules",
        "public",
        "bootstrap/ssr",
        "vite.config.ts",
        "resources/js/actions/**",
        "resources/js/components/ui/*",
        "resources/js/routes/**",
        "resources/js/wayfinder/**"
    ]
}
